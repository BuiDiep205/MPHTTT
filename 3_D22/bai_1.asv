clc; clear;

fs = 1000;
ts = 1/fs;
L = 2000;
t = (0:L-1)*ts;

x = cos(40*pi*t - pi) + 3*cos(30*pi*t);

%a
figure;
subplot(2,1,1);
plot(t, x, 'LineWidth', 1.5);
grid on;
title('Tin hieu trong mien thoi gian');

%b
x_fft = fft(x);
P2 = abs(x_fft/L);
P1 = P2(1:L/2+1);
P1(2:end-1) = 2*P1(2:end-1);

f = fs*(0:(L/2))/L;

%c
subplot(2,1,2);
plot(f, );
