clc; clear;

fs = 200000;
Ts = 1/fs;
F = 10;
T = 1/F;
t = 0:Ts:10*T-ts;

x = cos(20*pi*t + pi/2);

%a;
f = 1000;
a = 2;
phic = pi;
m = 0.5;
Am = max(abs(x));
x_norm = x/Am;

xc = a*cos(2*pi*f + phic);

s = (1 + m*x_norm) .* xc;

%b
figure;
subplot(3,1,1);
plot(t, x, 'LineWidth',1.5);
title('Tin hieu ban tin');
grid on;

subplot(3,1,2);
plot(t, xc, 'LineWidth',1.5);
title('Tin hieu song mang');
grid on;

subplot(3,1,3);
plot(t, x, 'LineWidth',1.5);
title('Tin hieu sau dieu che');
grid on;





